# Copy to .env and fill in. NEVER commit the real .env or ship these values to the browser.

# Telegram bot token from @BotFather. Required to verify initData signatures.
BOT_TOKEN=123456789:AAExampleTelegramBotTokenXXXXXXXXXXXXX

# Secret used to sign the session JWT this server issues after a successful
# Telegram verification. Generate with: openssl rand -hex 32
SESSION_JWT_SECRET=replace-with-a-long-random-string

# How long an issued session stays valid.
SESSION_TTL_HOURS=24

# How old initData.auth_date is allowed to be before it's rejected as a replay.
INITDATA_MAX_AGE_HOURS=24

# Comma-separated list of origins allowed to call this API (your Mini App's
# deployed URL(s)). Example: https://your-app.example.com,https://t.me
CORS_ORIGINS=*

# Port the server listens on.
PORT=8787

# Local Python FastAPI bridge used by /api/refresh and model discovery.
BRIDGE_URL=http://127.0.0.1:6767
BRIDGE_API_KEY=

# Optional Telegram MTProto credentials for the separate userbot/log service.
# These are never sent to the browser.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Where the JSON "config" (api keys, arena auth tokens, cf_clearance) is
# persisted. Swap this file-based store for a real DB in production.
DATA_FILE=./data/config.json
