# LMArena Bridge — secrets & runtime configuration
#
# Copy to `.env` in the repo root (`cp .env.example .env`) and fill in the values.
# Setuper.sh writes this file for you; you normally only supply BOT_TOKEN and let
# the bot collect the rest inside Telegram.
#
# Everything secret lives HERE, never in WEB/data/config.json (that file is
# runtime state: it is rewritten by background refresh tasks and mirrored by the
# dashboard). chmod 600 this file.
#
# Resolution order for every value: real environment variable > this file > default.

# ── Telegram bot (required) ───────────────────────────────────────────────────
# From @BotFather. Enable inline mode too: /setinline -> @your_bot -> "value"
BOT_TOKEN=

# Numeric Telegram user id of the owner. Leave EMPTY on a fresh install: the bot
# starts in echo-id mode and the first person who DMs it becomes the owner,
# writing the id back here automatically.
OWNER_ID=
ADMIN_ID=

# Extra owner ids allowed to drive the bot (comma separated). Optional.
BOT_ALLOWED_USERS=

# ── Telegram MTProto (Telethon layer: premium emoji in inline, media) ─────────
# From https://my.telegram.org. Collected via inline input in the bot's /setup —
# you do not have to type them in a terminal.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── Bot log forwarding ───────────────────────────────────────────────────────
# Set automatically when the owner adds the bot to a group (or sends /here there).
BOT_LOG_GROUP_ID=
BOT_LOG_TOPIC_ID=
BOT_REQUESTS_TOPIC_ID=
# Seconds between bridge-log pushes to the Logs topic.
BOT_LOG_FORWARD_INTERVAL=20

# ── Dashboard (WEB/server.js, port 8787) ─────────────────────────────────────
# HMAC secret for the session cookie. Generate: openssl rand -hex 32
SESSION_JWT_SECRET=
SESSION_TTL_HOURS=24
INITDATA_MAX_AGE_HOURS=24
CORS_ORIGINS=*
PORT=8787
# DEV_MODE=true lets ANY caller POST {"initData":"dev"} and receive a session with
# full access to keys and tokens. Keep it false on anything reachable from a tunnel.
DEV_MODE=false
# Absolute path to the bridge's runtime state file (non-secret).
DATA_FILE=/home/forget/Arena/WEB/data/config.json

# ── Bridge API (OpenAI-compatible, port 6767) ────────────────────────────────
BRIDGE_URL=http://127.0.0.1:6767
# Primary key clients send as `Authorization: Bearer <key>`.
# Generate: printf 'sk-%s\n' "$(head -c 32 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 48)"
BRIDGE_API_KEY=
# Additional accepted keys, comma separated. Optional.
BRIDGE_API_KEYS=

# ── arena.ai session ─────────────────────────────────────────────────────────
# `arena-auth-prod-v1` cookie value (starts with "base64-"). Comma-separate
# several for rotation. Refreshed automatically by the bridge via Camoufox.
ARENA_AUTH_TOKEN=
# Cloudflare clearance cookie, refreshed automatically.
ARENA_CF_CLEARANCE=
# JSON blob of the remaining browser cookies, maintained by the bridge.
ARENA_BROWSER_COOKIES=

# ── Optional ─────────────────────────────────────────────────────────────────
# GitHub PAT, used ONLY as a fallback when the anonymous Camoufox browser
# download hits GitHub's rate limit. Needs no scopes (public read is enough).
GITHUB_TOKEN=
